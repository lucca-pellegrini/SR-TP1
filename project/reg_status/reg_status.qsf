set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C35F672C6
set_global_assignment -name TOP_LEVEL_ENTITY reg_status
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "9.1 SP2"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "12:00:00  OCTOBER 15, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name VHDL_FILE reg_status.vhd
set_global_assignment -name VECTOR_WAVEFORM_FILE reg_status.vwf
set_global_assignment -name VECTOR_WAVEFORM_FILE reg_status_alu.vwf
set_global_assignment -name VECTOR_WAVEFORM_FILE reg_status_enable.vwf
set_global_assignment -name VECTOR_WAVEFORM_FILE reg_status_escrita.vwf
set_global_assignment -name VECTOR_WAVEFORM_FILE reg_status_reset.vwf
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name SIMULATION_MODE FUNCTIONAL
set_global_assignment -name VECTOR_OUTPUT_FORMAT VWF
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST ON -section_id eda_simulation
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# Evita o aviso "Parallel compilation is not licensed" (Web Edition só
# permite 1 processador mesmo com mais núcleos disponíveis).
set_global_assignment -name NUM_PARALLEL_PROCESSORS 1

# Restrição de clock para o TimeQuest (evita o aviso de SDC ausente).
set_global_assignment -name SDC_FILE reg_status.sdc

# Este projeto não tem atribuição de pinos (só o componente, sem a camada
# da DE2), então o Fitter escolhe os pinos sozinho. Os avisos (169085) de
# pinos sem localização e (306006) de saídas sem carga são esperados e foram
# suprimidos de propósito. Os pinos não usados ficam como entradas em
# tri-state, que é o estado seguro.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name MESSAGE_DISABLE 169085
set_global_assignment -name MESSAGE_DISABLE 306006

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name INCREMENTAL_VECTOR_INPUT_SOURCE /home/luc/src/vscode/sr/tp1/project/reg_status/reg_status.vwf
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top